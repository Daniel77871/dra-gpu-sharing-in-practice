    "spec": {
      "nodeName": "dra-a40",
      "containers": [
        {
          "name": "gpus",
          "image": "nvcr.io/nvidia/dra-driver-nvidia-gpu:v0.5.0",
          "command": [
            "bash",
            "-c"
          ],
          "args": [
            "# Conditionally mask the params file to prevent this container from\n# recreating any missing GPU device nodes. This is necessary, for\n# example, when running under nvkind to limit the set GPUs governed\n# by the plugin even though it has cgroup access to all of them.\nif [ \"${MASK_NVIDIA_DRIVER_PARAMS}\" = \"true\" ]; then\n  cp /proc/driver/nvidia/params /root/gpu-params\n  sed -i 's/^ModifyDeviceFiles: 1$/ModifyDeviceFiles: 0/' /root/gpu-params\n  mount --bind /root/gpu-params /proc/driver/nvidia/params\nfi\ngpu-kubelet-plugin -v $(LOG_VERBOSITY)"
          ],
          "env": [
            {
              "name": "HTTP_ENDPOINT",
              "value": ":8080"
            },
            {
              "name": "METRICS_PATH",
              "value": "/metrics"
            },
            {
              "name": "LOG_VERBOSITY",
              "value": "4"
            },
            {
              "name": "MASK_NVIDIA_DRIVER_PARAMS"
            },
            {
              "name": "NVIDIA_DRIVER_ROOT",
              "value": "/run/nvidia/driver"
            },
            {
              "name": "NVIDIA_VISIBLE_DEVICES",
              "value": "void"
            },
            {
              "name": "CDI_ROOT",
              "value": "/var/run/cdi"
            },
            {
              "name": "NVIDIA_MIG_CONFIG_DEVICES",
              "value": "all"
            },
            {
              "name": "NODE_NAME",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "spec.nodeName"
                }
              }
            },
            {
              "name": "NAMESPACE",
              "valueFrom": {
                "fieldRef": {
